NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (example)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority"

# Logging
LOG_LEVEL=info
LOG_SINK=file
LOG_FILE=./logs/app.log


SEED_ADMIN_API_KEY=admin_demo_key
SEED_REVIEWER_API_KEY=reviewer_demo_key

# Deployments (e.g. Render)
# If set to 1, the app will run the seed script on process start. Keep this off for persistent cloud DBs.
RUN_SEED_ON_START=0
